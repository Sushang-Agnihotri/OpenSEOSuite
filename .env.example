# Copy to .env (Docker: next to docker-compose.yml; manual install: inside backend/). Every value is optional.

# --- Storage ---------------------------------------------------------------------------------
# Directory for the SQLite database and the generated secret key.
#SEO_DATA_DIR=./data
# Use PostgreSQL instead of SQLite (install the extra first: pip install ".[postgres]").
#SEO_DATABASE_URL=postgresql+psycopg://seotoolkit:change-me@postgres:5432/seotoolkit
#POSTGRES_PASSWORD=change-me

# --- Security --------------------------------------------------------------------------------
# Signing key for login tokens. If empty, a random key is generated and stored in SEO_DATA_DIR/.secret_key.
#SEO_SECRET_KEY=
# The first account can always be created and becomes the administrator. Further sign-ups are refused unless you set this to true.
#SEO_ALLOW_REGISTRATION=false
# Reverse proxies (IPs or CIDRs, comma separated) whose X-Forwarded-For header is believed, so rate limiting sees real client addresses.
#SEO_TRUSTED_PROXIES=
# Request bodies other than file uploads, in KB. Uploads are limited by SEO_MAX_UPLOAD_MB.
#SEO_MAX_JSON_BODY_KB=1024
# Serve Swagger UI / ReDoc under /api/docs and /api/redoc.
#SEO_ENABLE_API_DOCS=true
#SEO_ACCESS_TOKEN_MINUTES=720
# Browser origins allowed to call the API (only needed when the frontend is served from another origin, e.g. Vite dev server).
#SEO_CORS_ORIGINS=http://localhost:5173
#SEO_API_RATE_LIMIT_PER_MINUTE=600
#SEO_LOGIN_RATE_LIMIT_PER_MINUTE=10
#SEO_MAX_UPLOAD_MB=20

# --- Crawler ---------------------------------------------------------------------------------
# Keep false unless you need to audit sites on localhost or a private network. When false, the crawler refuses
# loopback, private, link-local and other non-public addresses (SSRF protection).
#SEO_ALLOW_PRIVATE_NETWORKS=false
#SEO_USER_AGENT=UltimateSEOToolkit/0.1 (+https://github.com/ultimate-open-source-seo-toolkit)
#SEO_CRAWL_MAX_URLS_HARD_LIMIT=200000
#SEO_CRAWL_MAX_BODY_MB=8
#SEO_MAX_CONCURRENT_JOBS=3
# Queued + running background jobs one account may have at a time.
#SEO_MAX_JOBS_PER_USER=8
# Chromium sandbox for JavaScript rendering. Turn off only where it cannot start (some containers).
#SEO_RENDER_SANDBOX=true

# --- Misc ------------------------------------------------------------------------------------
# Public URL of this installation; used to build the Google OAuth redirect URI (<url>/api/gsc/callback).
#SEO_PUBLIC_BASE_URL=http://localhost:8000
#SEO_SCHEDULER_ENABLED=true
#SEO_LOG_LEVEL=INFO
# Emit one JSON object per log line (for log aggregators / error monitoring).
#SEO_LOG_JSON=false
#SEO_PORT=8000
# Docker Compose publishes on this address. 127.0.0.1 = this machine only; 0.0.0.0 = all interfaces (use HTTPS in front).
#SEO_BIND=127.0.0.1

# API keys for optional integrations (PageSpeed Insights, SERP providers, AI, Google OAuth client) are entered in the
# app under Settings and stored in the database, not here.
